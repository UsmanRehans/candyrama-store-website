generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Category {
  GUMMIES
  SOUR
  SPICY
  BRITTLE
  BARK
  CHOCOLATE
  CHEWS
  GIFT_BOXES
  SEASONAL
}

enum OrderStatus {
  PENDING
  PAID
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WholesaleStatus {
  NEW
  REVIEWING
  APPROVED
  DECLINED
}

model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  category Category
  tagline String?
  description String
  ingredients String
  allergens String[]
  netWeight String
  priceCents Int
  compareAtCents Int?
  stockQty Int @default(0)
  lowStockAt Int @default(6)
  status ProductStatus @default(DRAFT)
  isSeasonal Boolean @default(false)
  availableFrom DateTime?
  availableTo DateTime?
  accentColor String @default("#EA537B")
  stripePriceId String? @unique
  images ProductImage[]
  reviews Review[]
  orderItems OrderItem[]
  stockMovements StockMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, category])
  @@index([createdAt])
}

model ProductImage {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storagePath String
  url String
  alt String
  position Int @default(0)
  createdAt DateTime @default(now())
  @@index([productId, position])
}

model Customer {
  id String @id @default(cuid())
  email String @unique
  name String?
  phone String?
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])
  email String
  status OrderStatus @default(PENDING)
  items OrderItem[]
  subtotalCents Int
  discountCents Int @default(0)
  shippingCents Int
  taxCents Int
  totalCents Int
  discountCode String?
  shippingName String
  shippingLine1 String
  shippingLine2 String?
  shippingCity String
  shippingState String
  shippingZip String
  shippingCountry String @default("US")
  carrier String?
  serviceLevel String?
  trackingNumber String?
  shippingLabelUrl String?
  stripeSessionId String? @unique
  stripePaymentIntentId String? @unique
  internalNote String?
  paidAt DateTime?
  shippedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, orderNumber])
  @@index([status, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  nameSnapshot String
  priceCents Int
  quantity Int
  @@index([orderId])
  @@index([productId])
}

model StockMovement {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta Int
  reason String
  orderId String?
  actorId String?
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
}

model Discount {
  id String @id @default(cuid())
  code String @unique
  type DiscountType
  value Int
  minimumCents Int?
  usageLimit Int?
  usageCount Int @default(0)
  active Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  email String
  rating Int
  title String?
  body String
  status ReviewStatus @default(PENDING)
  verifiedOrder Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([productId, status, createdAt])
}

model WholesaleApplication {
  id String @id @default(cuid())
  businessName String
  contactName String
  email String
  phone String?
  website String?
  estimatedQuantity String
  message String?
  status WholesaleStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model Stockist {
  id String @id @default(cuid())
  name String
  addressLine1 String
  addressLine2 String?
  city String
  state String
  postalCode String
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  website String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, state, city])
}

model AdminProfile {
  userId String @id
  email String @unique
  role String @default("staff")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id String @id
  provider String
  eventType String
  processedAt DateTime @default(now())
  @@index([provider, processedAt])
}

model CheckoutAttempt {
  id String @id @default(cuid())
  stripeSessionId String? @unique
  status String @default("OPEN")
  email String?
  items Json
  subtotalCents Int
  shippingCents Int
  expiresAt DateTime
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, expiresAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  resourceType String
  resourceId String?
  metadata Json?
  ipHash String?
  createdAt DateTime @default(now())
  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
}

model OrderSequence {
  key String @id
  value Int @default(1000)
}
